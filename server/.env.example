# Copy to server/.env and fill in. The server fails fast if any required
# variable is missing.

# Required. Origin of the web app, used for CORS. Must match the Vite dev
# server (or deployed web origin) exactly, including scheme and port.
CLIENT_ORIGIN=http://localhost:5173

# Required. Path to the SQLite database file. Relative paths resolve from
# server/. Keep this under server/data/ so it stays covered by .gitignore.
DATABASE_PATH=data/app.db

# Optional. Port the server listens on. Defaults to 4000.
PORT=4000

# Optional. Set to "production" to enable secure (HTTPS-only) session
# cookies. Defaults to "development".
NODE_ENV=development
